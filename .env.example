# Supabase (Project Settings > API en supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (misma pantalla, clave "service_role" / secreta).
# NUNCA con prefijo NEXT_PUBLIC_: solo se usa del lado del servidor, para
# invitar gente al equipo desde /configuracion/equipo. No compartir ni
# commitear.
SUPABASE_SERVICE_ROLE_KEY=
